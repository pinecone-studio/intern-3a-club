{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "jsx": "react"
  },
  "include": [
    "jest.config.ts",
    "src/**/*.spec.*",
    "src/**/*.test.*",
    "__test__/**/*.spec.*",
    "__test__/**/*.test.*",
    "app/**/*.ts",
    "app/**/*.tsx",
    "**/*.d.ts"
  ]
}
