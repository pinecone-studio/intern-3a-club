{
  "extends": ["plugin:@nx/react", "../../.eslintrc.json"],
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["libs/shadcn/src/lib/ui/*.tsx"],
      "rules": {
        "unicorn/filename-case": "off",
        "complexity": "off",
        "max-lines": "off",
        "camelcase": "off"
      }
    }
  ]
}
